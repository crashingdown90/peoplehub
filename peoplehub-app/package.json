{
  "name": "peoplehub-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "dev:turbo": "next dev --turbo",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest tests/services",
    "test:api": "jest tests/api",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "prepare": "node scripts/ensure-hooks-path.js",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:seed:e2e": "npx tsx prisma/seed-e2e.ts",
    "db:migrate": "npx prisma migrate dev",
    "db:migrate:deploy": "npx prisma migrate deploy",
    "db:migrate:status": "npx prisma migrate status",
    "db:studio": "npx prisma studio",
    "test:e2e:setup": "npm run db:seed:e2e && playwright test --project=setup",
    "migrate:pre-check": "npx tsx scripts/migrations/pre-migrate.ts",
    "migrate:post-check": "npx tsx scripts/migrations/post-migrate.ts",
    "migrate:validate": "npx tsx scripts/migrations/validate-data.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@prisma/adapter-pg": "^7.2.0",

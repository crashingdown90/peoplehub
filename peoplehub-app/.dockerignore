# =============================================================================
# Docker Ignore File
# =============================================================================
# Files and directories to exclude from Docker build context
# =============================================================================

# Dependencies
node_modules
.pnpm-store

# Build outputs (we build inside container)
.next
out
dist
build

# Git
.git
.gitignore

# IDE
.idea
.vscode
*.swp
*.swo
.DS_Store

# Environment files (should be passed as env vars or secrets)
.env
.env.local
.env.*.local
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs

# Test files
coverage
.nyc_output
playwright-report
test-results

# Documentation
docs
*.md
!README.md

# CI/CD
.github
.gitlab

# Development files
.husky
e2e
tests
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx
jest.config.js
jest.setup.js
playwright.config.ts

# Temporary files
*.tmp
*.temp
.cache
tmp

# Editor configs
.editorconfig
.prettierrc
.prettierignore
.eslintrc*
eslint.config.mjs

# TypeScript build info
*.tsbuildinfo

# Prisma migrations (migrations should be in the image)
# prisma/migrations

# Scripts (some might not be needed in container)
scripts/*.sh

# Docker files (prevent recursion)
Dockerfile*
docker-compose*
.dockerignore

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id                 String              @id @default(cuid())
  name               String
  domain             String?             @unique
  code               String?             @unique
  branding           Json?
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  announcements      Announcement[]
  attendanceSettings AttendanceSettings?
  attendances        Attendance[]
  branches           Branch[]
  departments        Department[]
  employees          Employee[]
  holidays           Holiday[]
  leaveTypes         LeaveType[]
  notifications      Notification[]
  positions          Position[]
  shifts             Shift[]
  users              User[]

  @@map("tenants")
}

model User {
  id                    String         @id @default(cuid())
  tenantId              String
  email                 String
  phone                 String?
  passwordHash          String
  fullName              String         @default("")
  status                UserStatus     @default(PENDING)
  role                  UserRole       @default(EMPLOYEE)
  emailVerifiedAt       DateTime?
  lastLoginAt           DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  /// Soft delete timestamp
  deletedAt             DateTime?
  gender                Gender?
  birthPlace            String?
  birthDate             DateTime?
  photoUrl              String?
  /// Bank code from BANK_LIST constant (e.g., "BCA", "MANDIRI")
  bankName              String?
  bankAccountNumber     String?
  bankAccountHolder     String?
  nik                   String?
  npwp                  String?
  address               String?
  ktpPhotoUrl           String?
  emergencyContactName  String?
  emergencyContactPhone String?
  employee              Employee?
  notifications         Notification[]
  announcementsCreated  Announcement[] @relation("AnnouncementCreator")
  tenant                Tenant         @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, email])
  @@index([tenantId, status])
  @@map("users")
}

model Employee {
  id                    String                 @id @default(cuid())
  tenantId              String
  userId                String                 @unique
  employeeCode          String?
  branchId              String?
  departmentId          String?
  positionId            String?
  managerId             String?
  employeeNumber        String
  fullName              String
  nik                   String?
  npwp                  String?
  bpjsKesehatan         String?
  bpjsKetenagakerjaan   String?
  employmentType        EmploymentType         @default(PERMANENT)
  workMode              WorkMode               @default(WFO)
  startDate             DateTime
  endDate               DateTime?
  phone                 String?
  address               String?
  emergencyContactName  String?
  emergencyContactPhone String?
  /// Bank code from BANK_LIST constant (e.g., "BCA", "MANDIRI")
  bankName              String?
  bankAccountNumber     String?
  bankAccountHolder     String?
  bankBranch            String?
  status                EmployeeStatus         @default(ACTIVE)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  /// Soft delete timestamp
  deletedAt             DateTime?
  attendanceCorrections AttendanceCorrection[] @relation("EmployeeCorrections")
  attendances           Attendance[]           @relation("EmployeeAttendances")
  bankChangeRequests    BankChangeRequest[]    @relation("EmployeeBankChanges")
  cashAdvances          CashAdvance[]          @relation("EmployeeCashAdvances")
  branch                Branch?                @relation(fields: [branchId], references: [id], onDelete: SetNull)
  department            Department?            @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  manager               Employee?              @relation("ManagerSubordinates", fields: [managerId], references: [id], onDelete: SetNull)
  subordinates          Employee[]             @relation("ManagerSubordinates")
  position              Position?              @relation(fields: [positionId], references: [id], onDelete: SetNull)
  tenant                Tenant                 @relation(fields: [tenantId], references: [id])
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses              Expense[]              @relation("EmployeeExpenses")
  kpiTargets            KpiTarget[]            @relation("EmployeeKpiTargets")
  leaveBalances         LeaveBalance[]         @relation("EmployeeLeaveBalances")
  leaveRequests         LeaveRequest[]         @relation("EmployeeLeaveRequests")
  overtimeRequests      OvertimeRequest[]      @relation("EmployeeOvertimeRequests")
  payslips              Payslip[]              @relation("EmployeePayslips")
  reimburseRequests     ReimburseRequest[]     @relation("EmployeeReimburseRequests")
  travelRequests        TravelRequest[]        @relation("EmployeeTravelRequests")

  @@unique([tenantId, employeeNumber])
  @@unique([tenantId, employeeCode])
  @@index([tenantId, branchId])
  @@index([tenantId, departmentId])
  @@index([tenantId, status])
  @@map("employees")
}

model Branch {
  id                   String       @id @default(cuid())
  tenantId             String
  code                 String
  name                 String
  address              String?
  city                 String?
  timezone             String       @default("Asia/Jakarta")
  latitude             Decimal?
  longitude            Decimal?
  geofenceRadiusMeters Int?         @default(100)
  isActive             Boolean      @default(true)
  createdAt            DateTime     @default(now())
  tenant               Tenant       @relation(fields: [tenantId], references: [id])
  departments          Department[]
  employees            Employee[]
  holidays             Holiday[]

  @@unique([tenantId, code])
  @@map("branches")
}

model Department {
  id        String     @id @default(cuid())
  tenantId  String
  branchId  String?
  code      String
  name      String
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  branch    Branch?    @relation(fields: [branchId], references: [id])
  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  employees Employee[]

  @@unique([tenantId, code])
  @@map("departments")
}

model Position {
  id        String     @id @default(cuid())
  tenantId  String
  code      String
  name      String
  level     Int        @default(1)
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  employees Employee[]
  tenant    Tenant     @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, code])
  @@map("positions")
}

model Shift {
  id           String     @id @default(cuid())
  tenantId     String
  name         String
  startTime    String
  endTime      String
  breakMinutes Int        @default(60)
  isFlexible   Boolean    @default(false)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  schedules    Schedule[]
  tenant       Tenant     @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("shifts")
}

model Schedule {
  id           String      @id @default(cuid())
  tenantId     String
  employeeId   String
  shiftId      String?
  scheduleDate DateTime    @db.Date
  workMode     WorkMode    @default(WFO)
  isHoliday    Boolean     @default(false)
  createdAt    DateTime    @default(now())
  attendance   Attendance?
  shift        Shift?      @relation(fields: [shiftId], references: [id])

  @@unique([employeeId, scheduleDate])
  @@index([tenantId, scheduleDate])
  @@index([tenantId, employeeId])
  @@map("schedules")
}

model Attendance {
  id                   String           @id @default(cuid())
  tenantId             String
  employeeId           String
  scheduleId           String?          @unique
  attendanceDate       DateTime         @db.Date
  clockIn              DateTime?
  clockOut             DateTime?
  workMode             WorkMode         @default(WFO)
  clockInPhotoUrl      String?
  clockOutPhotoUrl     String?
  selfieIn             String?
  selfieOut            String?
  locationIn           Json?
  locationOut          Json?
  notes                String?
  clockInLatitude      Decimal?
  clockInLongitude     Decimal?
  clockOutLatitude     Decimal?
  clockOutLongitude    Decimal?
  deviceInfo           String?
  lateMinutes          Int              @default(0)
  earlyLeaveMinutes    Int              @default(0)
  overtimeMinutes      Int              @default(0)
  lateDeductionAmount  Decimal          @default(0)
  status               AttendanceStatus @default(PRESENT)
  isCorrected          Boolean          @default(false)
  geofenceStatus       String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  faceDetectedIn       Boolean?
  faceConfidenceIn     Decimal?
  faceDetectedOut      Boolean?
  faceConfidenceOut    Decimal?
  livenessScoreIn      Decimal?
  livenessChallengeIn  String?
  livenessScoreOut     Decimal?
  livenessChallengeOut String?
  clockInGpsAccuracy   Decimal?
  clockOutGpsAccuracy  Decimal?
  employee             Employee         @relation("EmployeeAttendances", fields: [employeeId], references: [id], onDelete: Cascade)
  schedule             Schedule?        @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  tenant               Tenant           @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, employeeId, attendanceDate])
  @@index([tenantId, attendanceDate])
  @@index([tenantId, status])
  @@index([tenantId, employeeId])
  @@index([employeeId, attendanceDate])
  @@map("attendances")
}

model AttendanceSettings {
  id                   String   @id @default(cuid())
  tenantId             String   @unique
  defaultShiftStart    String   @default("08:00")
  defaultShiftEnd      String   @default("17:00")
  breakMinutes         Int      @default(60)
  earliestClockIn      String   @default("06:00")
  latestClockOut       String   @default("22:00")
  gracePeriodMinutes   Int      @default(5)
  lateDeductionEnabled Boolean  @default(false)
  lateDeductionType    String   @default("PER_MINUTE")
  lateDeductionAmount  Decimal  @default(0)
  geofenceRadius       Int      @default(100)
  geofenceEnabled      Boolean  @default(true)
  requireFaceDetection Boolean  @default(true)
  requireLiveness      Boolean  @default(true)
  minFaceConfidence    Decimal  @default(0.7)
  workDays             Json     @default("[1, 2, 3, 4, 5]")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  tenant               Tenant   @relation(fields: [tenantId], references: [id])

  @@map("attendance_settings")
}

model LeaveType {
  id                 String         @id @default(cuid())
  tenantId           String
  code               String
  name               String
  defaultBalance     Int            @default(12)
  isPaid             Boolean        @default(true)
  requiresAttachment Boolean        @default(false)
  isActive           Boolean        @default(true)
  createdAt          DateTime       @default(now())
  leaveBalances      LeaveBalance[]
  leaveRequests      LeaveRequest[]
  tenant             Tenant         @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, code])
  @@map("leave_types")
}

model LeaveBalance {
  id               String    @id @default(cuid())
  tenantId         String
  employeeId       String
  leaveTypeId      String
  year             Int
  initialBalance   Int
  usedBalance      Int       @default(0)
  remainingBalance Int
  expiryDate       DateTime? @db.Date
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  employee         Employee  @relation("EmployeeLeaveBalances", fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType        LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, leaveTypeId, year])
  @@index([tenantId, employeeId, year])
  @@map("leave_balances")
}

model LeaveRequest {
  id                  String         @id @default(cuid())
  tenantId            String
  employeeId          String
  leaveTypeId         String
  startDate           DateTime       @db.Date
  endDate             DateTime       @db.Date
  totalDays           Int
  reason              String
  attachmentUrl       String?
  delegateToId        String?
  status              ApprovalStatus @default(PENDING)
  approvedByManagerId String?
  approvedByHrdId     String?
  managerApprovedAt   DateTime?
  hrdApprovedAt       DateTime?
  rejectionReason     String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  /// Soft delete timestamp
  deletedAt           DateTime?
  employee            Employee       @relation("EmployeeLeaveRequests", fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType           LeaveType      @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)

  @@index([tenantId, status])
  @@index([employeeId, status])
  @@index([tenantId, employeeId, status])
  @@index([startDate, endDate])
  @@index([tenantId, employeeId, startDate])
  @@index([tenantId, approvedByManagerId, status])
  @@map("leave_requests")
}

model Announcement {
  id             String             @id @default(cuid())
  tenantId       String
  title          String
  content        String
  targetAudience Json?
  priority       String             @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  isPinned       Boolean            @default(false)
  attachments    Json?              // [{name, url, type, size}]
  status         String             @default("DRAFT") // DRAFT, PUBLISHED, ARCHIVED
  createdById    String
  publishedById  String?
  publishedAt    DateTime?
  expiresAt      DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  reads          AnnouncementRead[]
  tenant         Tenant             @relation(fields: [tenantId], references: [id])
  createdBy      User               @relation("AnnouncementCreator", fields: [createdById], references: [id])

  @@index([tenantId, status])
  @@index([tenantId, isPinned, publishedAt])
  @@map("announcements")
}

model Holiday {
  id          String   @id @default(cuid())
  tenantId    String
  branchId    String?
  name        String
  holidayDate DateTime @db.Date
  isNational  Boolean  @default(false)
  createdAt   DateTime @default(now())
  branch      Branch?  @relation(fields: [branchId], references: [id])
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, branchId, holidayDate])
  @@map("holidays")
}

model Payslip {
  id                  String        @id @default(cuid())
  tenantId            String
  employeeId          String
  period              String
  basicSalary         Decimal       @default(0)
  allowances          Json?
  overtimeAmount      Decimal       @default(0)
  bonus               Decimal       @default(0)
  lateDeduction       Decimal       @default(0)
  absentDeduction     Decimal       @default(0)
  taxDeduction        Decimal       @default(0)
  bpjsKesehatan       Decimal       @default(0)
  bpjsKetenagakerjaan Decimal       @default(0)
  otherDeductions     Json?
  grossSalary         Decimal       @default(0)
  totalDeductions     Decimal       @default(0)
  netSalary           Decimal       @default(0)
  workDays            Int           @default(0)
  presentDays         Int           @default(0)
  lateDays            Int           @default(0)
  absentDays          Int           @default(0)
  leaveDays           Int           @default(0)
  overtimeHours       Decimal       @default(0)
  status              PayslipStatus @default(DRAFT)
  publishedAt         DateTime?
  generatedById       String?
  notes               String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  employee            Employee      @relation("EmployeePayslips", fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([tenantId, employeeId, period])
  @@index([tenantId, period])
  @@index([tenantId, status])
  @@map("payslips")
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  actorId    String?
  action     String
  objectType String
  objectId   String?
  beforeData Json?
  afterData  Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([tenantId, action])
  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

model Notification {
  id         String           @id @default(cuid())
  tenantId   String
  userId     String
  type       NotificationType
  title      String
  message    String
  link       String?
  objectType String?
  objectId   String?
  isRead     Boolean          @default(false)
  readAt     DateTime?
  createdAt  DateTime         @default(now())
  tenant     Tenant           @relation(fields: [tenantId], references: [id])
  user       User             @relation(fields: [userId], references: [id])

  @@index([tenantId, userId])
  @@index([userId, isRead])
  @@index([tenantId, createdAt])
  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

model NotificationPreference {
  id                 String   @id @default(cuid())
  tenantId           String
  userId             String
  emailEnabled       Boolean  @default(true)
  emailDigest        String   @default("REALTIME")
  inAppEnabled       Boolean  @default(true)
  attendanceAlerts   Boolean  @default(true)
  leaveAlerts        Boolean  @default(true)
  approvalAlerts     Boolean  @default(true)
  announcementAlerts Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@map("notification_preferences")
}

model AttendanceCorrection {
  id                String         @id @default(cuid())
  tenantId          String
  employeeId        String
  attendanceDate    DateTime       @db.Date
  originalClockIn   DateTime?
  originalClockOut  DateTime?
  requestedClockIn  DateTime?
  requestedClockOut DateTime?
  reason            String
  status            ApprovalStatus @default(PENDING)
  approvedById      String?
  approvedAt        DateTime?
  rejectionReason   String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  employee          Employee       @relation("EmployeeCorrections", fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([employeeId, status])
  @@map("attendance_corrections")
}

model TravelRequest {
  id                  String         @id @default(cuid())
  tenantId            String
  employeeId          String
  destination         String
  purpose             String
  departureDate       DateTime       @db.Date
  returnDate          DateTime       @db.Date
  estimatedBudget     Decimal        @default(0)
  transportation      String?
  accommodation       String?
  notes               String?
  status              ApprovalStatus @default(PENDING)
  approvedByManagerId String?
  managerApprovedAt   DateTime?
  approvedByHrdId     String?
  hrdApprovedAt       DateTime?
  rejectionReason     String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  /// Soft delete timestamp
  deletedAt           DateTime?
  employee            Employee       @relation("EmployeeTravelRequests", fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([employeeId, status])
  @@index([tenantId, approvedByManagerId, status])
  @@map("travel_requests")
}

model ReimburseRequest {
  id                  String          @id @default(cuid())
  tenantId            String
  employeeId          String
  category            String
  totalAmount         Decimal
  description         String
  receipts            Json?
  status              ApprovalStatus  @default(PENDING)
  approvedByManagerId String?
  managerApprovedAt   DateTime?
  approvedByFinanceId String?
  financeApprovedAt   DateTime?
  rejectionReason     String?
  paidAt              DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  /// Soft delete timestamp
  deletedAt           DateTime?
  items               ReimburseItem[]
  employee            Employee        @relation("EmployeeReimburseRequests", fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([employeeId, status])
  @@index([tenantId, approvedByManagerId, status])
  @@map("reimburse_requests")
}

model ReimburseItem {
  id          String           @id @default(cuid())
  reimburseId String
  description String
  amount      Decimal
  receiptUrl  String?
  date        DateTime         @db.Date
  createdAt   DateTime         @default(now())
  reimburse   ReimburseRequest @relation(fields: [reimburseId], references: [id], onDelete: Cascade)

  @@index([reimburseId])
  @@map("reimburse_items")
}

model ExpenseCategory {
  id          String    @id @default(cuid())
  tenantId    String
  code        String
  name        String
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  expenses    Expense[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
  @@map("expense_categories")
}

model Expense {
  id              String          @id @default(cuid())
  tenantId        String
  employeeId      String
  categoryId      String
  expenseDate     DateTime        @db.Date
  amount          Decimal
  description     String
  receiptUrl      String?
  status          ExpenseStatus   @default(PENDING)
  approvedById    String?
  approvedAt      DateTime?
  rejectionReason String?
  paidAt          DateTime?
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  category        ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  employee        Employee        @relation("EmployeeExpenses", fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId, employeeId])
  @@index([tenantId, status])
  @@index([tenantId, expenseDate])
  @@map("expenses")
}

model KpiPeriod {
  id         String      @id @default(cuid())
  tenantId   String
  name       String
  startDate  DateTime    @db.Date
  endDate    DateTime    @db.Date
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now())
  kpiTargets KpiTarget[]

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
  @@map("kpi_periods")
}

model KpiIndicator {
  id          String      @id @default(cuid())
  tenantId    String
  code        String
  name        String
  description String?
  unit        String
  targetType  String      @default("HIGHER_BETTER")
  weight      Decimal     @default(1)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  kpiTargets  KpiTarget[]

  @@unique([tenantId, code])
  @@map("kpi_indicators")
}

model KpiTarget {
  id          String       @id @default(cuid())
  tenantId    String
  employeeId  String
  periodId    String
  indicatorId String
  targetValue Decimal
  actualValue Decimal?
  score       Decimal?
  notes       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  employee    Employee     @relation("EmployeeKpiTargets", fields: [employeeId], references: [id], onDelete: Cascade)
  indicator   KpiIndicator @relation(fields: [indicatorId], references: [id], onDelete: Restrict)
  period      KpiPeriod    @relation(fields: [periodId], references: [id], onDelete: Restrict)

  @@unique([employeeId, periodId, indicatorId])
  @@index([tenantId, periodId])
  @@index([tenantId, employeeId])
  @@index([tenantId, employeeId, periodId])
  @@map("kpi_targets")
}

model Webhook {
  id          String       @id @default(cuid())
  tenantId    String
  name        String
  url         String
  secret      String?
  events      String[]
  isActive    Boolean      @default(true)
  headers     Json?
  retryCount  Int          @default(3)
  createdById String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  logs        WebhookLog[]

  @@index([tenantId, isActive])
  @@map("webhooks")
}

model WebhookLog {
  id        String   @id @default(cuid())
  webhookId String
  event     String
  payload   Json
  status    Int
  response  String?
  attempts  Int      @default(1)
  sentAt    DateTime @default(now())
  webhook   Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, sentAt])
  @@map("webhook_logs")
}

model Ticket {
  id           String          @id @default(cuid())
  tenantId     String
  ticketNumber String
  createdById  String
  assignedToId String?
  category     TicketCategory
  priority     TicketPriority  @default(NORMAL)
  status       TicketStatus    @default(OPEN)
  subject      String
  description  String
  resolution   String?
  resolvedById String?
  resolvedAt   DateTime?
  closedAt     DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  comments     TicketComment[]

  @@unique([tenantId, ticketNumber])
  @@index([tenantId, status])
  @@index([tenantId, category])
  @@index([tenantId, createdById])
  @@index([tenantId, assignedToId])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("tickets")
}

model TicketComment {
  id          String   @id @default(cuid())
  ticketId    String
  userId      String
  content     String
  isInternal  Boolean  @default(false)
  attachments Json?
  createdAt   DateTime @default(now())
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("ticket_comments")
}

model Token {
  id        String    @id @default(cuid())
  tenantId  String
  userId    String
  token     String    @unique
  type      TokenType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([tenantId, userId])
  @@index([token, type])
  @@index([expiresAt])
  @@map("tokens")
}

model Session {
  id           String    @id @default(cuid())
  tenantId     String
  userId       String
  token        String    @unique
  deviceInfo   String?
  ipAddress    String?
  userAgent    String?
  lastActiveAt DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([tenantId, userId])
  @@index([userId, expiresAt])
  @@index([token])
  @@map("sessions")
}

model RefreshToken {
  id         String    @id @default(cuid())
  tenantId   String
  userId     String
  token      String    @unique
  family     String
  parentId   String?
  deviceInfo String?
  ipAddress  String?
  expiresAt  DateTime
  usedAt     DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([tenantId, userId])
  @@index([token])
  @@index([family])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model LoginAttempt {
  id         String   @id @default(cuid())
  tenantId   String?
  email      String
  ipAddress  String
  userAgent  String?
  success    Boolean
  failReason String?
  createdAt  DateTime @default(now())

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
  @@index([tenantId, createdAt])
  @@map("login_attempts")
}

model Document {
  id           String              @id @default(cuid())
  tenantId     String
  employeeId   String
  type         DocumentType
  name         String
  description  String?
  fileUrl      String
  fileSize     Int?
  mimeType     String?
  version      Int                 @default(1)
  validFrom    DateTime?           @db.Date
  validUntil   DateTime?           @db.Date
  accessScope  DocumentAccessScope @default(OWNER)
  uploadedById String
  isActive     Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  /// Soft delete timestamp
  deletedAt    DateTime?

  @@index([tenantId, employeeId])
  @@index([tenantId, type])
  @@index([employeeId, type])
  @@index([tenantId, isActive])
  @@map("documents")
}

model ApprovalFlow {
  id          String           @id @default(cuid())
  tenantId    String
  name        String
  type        ApprovalFlowType
  description String?
  isActive    Boolean          @default(true)
  isDefault   Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  steps       ApprovalStep[]

  @@unique([tenantId, type, isDefault])
  @@index([tenantId, type])
  @@index([tenantId, isActive])
  @@map("approval_flows")
}

model ApprovalStep {
  id             String       @id @default(cuid())
  approvalFlowId String
  stepOrder      Int
  approverType   String
  approverUserId String?
  approverRoleId String?
  isRequired     Boolean      @default(true)
  canSkip        Boolean      @default(false)
  timeoutHours   Int?
  createdAt      DateTime     @default(now())
  approvalFlow   ApprovalFlow @relation(fields: [approvalFlowId], references: [id], onDelete: Cascade)

  @@index([approvalFlowId, stepOrder])
  @@map("approval_steps")
}

model ShiftSwap {
  id                 String          @id @default(cuid())
  tenantId           String
  requesterId        String
  partnerId          String
  requesterShiftDate DateTime        @db.Date
  partnerShiftDate   DateTime        @db.Date
  reason             String
  status             ShiftSwapStatus @default(PENDING_PARTNER)
  partnerApproved    Boolean         @default(false)
  partnerApprovedAt  DateTime?
  approvedById       String?
  approvedAt         DateTime?
  rejectionReason    String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([tenantId, requesterId])
  @@index([tenantId, partnerId])
  @@index([tenantId, status])
  @@map("shift_swaps")
}

model LateDeductionRule {
  id              String   @id @default(cuid())
  tenantId        String
  branchId        String?
  minLateMinutes  Int
  maxLateMinutes  Int
  deductionAmount Decimal
  deductionType   String   @default("FIXED")
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@index([tenantId, branchId])
  @@index([tenantId, isActive])
  @@map("late_deduction_rules")
}

model OvertimeRequest {
  id               String         @id @default(cuid())
  tenantId         String
  employeeId       String
  attendanceId     String?
  overtimeDate     DateTime       @db.Date
  plannedStartTime String
  plannedEndTime   String
  plannedHours     Decimal
  actualStartTime  String?
  actualEndTime    String?
  actualHours      Decimal?
  reason           String
  taskDescription  String?
  overtimeType     OvertimeType   @default(REGULAR)
  overtimeRate     Decimal?
  status           OvertimeStatus @default(PENDING)
  approvedById     String?
  approvedAt       DateTime?
  rejectionReason  String?
  completedAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  employee         Employee       @relation("EmployeeOvertimeRequests", fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId, employeeId])
  @@index([tenantId, overtimeDate])
  @@index([tenantId, status])
  @@map("overtime_requests")
}

model AnnouncementRead {
  id             String       @id @default(cuid())
  announcementId String
  employeeId     String
  readAt         DateTime     @default(now())
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@unique([announcementId, employeeId])
  @@index([employeeId])
  @@map("announcement_reads")
}

model LetterCategory {
  id                      String          @id @default(cuid())
  tenantId                String
  code                    String
  name                    String
  requiresManagerApproval Boolean         @default(true)
  templateFields          Json?
  isActive                Boolean         @default(true)
  createdAt               DateTime        @default(now())
  letterRequests          LetterRequest[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
  @@map("letter_categories")
}

model LetterRequest {
  id                  String         @id @default(cuid())
  tenantId            String
  employeeId          String
  letterCategoryId    String
  letterNumber        String?
  payload             Json?
  status              ApprovalStatus @default(PENDING)
  approvedByManagerId String?
  managerApprovedAt   DateTime?
  approvedByHrdId     String?
  hrdApprovedAt       DateTime?
  rejectionReason     String?
  letterPdfUrl        String?
  issuedAt            DateTime?
  issuedById          String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  letterCategory      LetterCategory @relation(fields: [letterCategoryId], references: [id], onDelete: Restrict)

  @@unique([tenantId, letterNumber])
  @@index([tenantId, status])
  @@index([tenantId, employeeId])
  @@map("letter_requests")
}

model ViolationNotice {
  id             String    @id @default(cuid())
  tenantId       String
  employeeId     String
  violationType  String
  description    String
  consequence    String?
  violationDate  DateTime  @db.Date
  issuedById     String
  notifiedAt     DateTime?
  acknowledged   Boolean   @default(false)
  acknowledgedAt DateTime?
  createdAt      DateTime  @default(now())

  @@index([tenantId, employeeId])
  @@index([tenantId, violationType])
  @@map("violation_notices")
}

model AssetLoan {
  id             String          @id @default(cuid())
  tenantId       String
  employeeId     String
  assetName      String
  assetCode      String?
  description    String?
  checkoutDate   DateTime        @db.Date
  dueDate        DateTime?       @db.Date
  returnDate     DateTime?       @db.Date
  status         AssetLoanStatus @default(ACTIVE)
  checkedOutById String
  returnedToId   String?
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([tenantId, employeeId])
  @@index([tenantId, status])
  @@index([tenantId, assetCode])
  @@map("asset_loans")
}

model CashAdvance {
  id              String            @id @default(cuid())
  tenantId        String
  employeeId      String
  amount          Decimal
  purpose         String
  status          CashAdvanceStatus @default(PENDING)
  settledAmount   Decimal?
  approvedById    String?
  approvedAt      DateTime?
  disbursedAt     DateTime?
  settledAt       DateTime?
  rejectionReason String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  employee        Employee          @relation("EmployeeCashAdvances", fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId, employeeId])
  @@index([tenantId, status])
  @@map("cash_advances")
}

model BankChangeRequest {
  id                    String           @id @default(cuid())
  tenantId              String
  employeeId            String
  oldBankName           String?
  oldAccountNumber      String?
  oldAccountHolder      String?
  oldBankBranch         String?
  newBankName           String
  newAccountNumber      String
  newAccountHolder      String
  newBankBranch         String?
  supportingDocumentUrl String?
  reason                String?
  status                BankChangeStatus @default(PENDING)
  approvedById          String?
  approvedAt            DateTime?
  rejectionReason       String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  employee              Employee         @relation("EmployeeBankChanges", fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId, employeeId])
  @@index([tenantId, status])
  @@map("bank_change_requests")
}

model Delegation {
  id             String         @id @default(cuid())
  tenantId       String
  delegatorId    String
  delegateId     String
  delegationType DelegationType
  requestTypes   String[]
  startDate      DateTime       @db.Date
  endDate        DateTime       @db.Date
  reason         String?
  isActive       Boolean        @default(true)
  createdById    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([tenantId, delegatorId])
  @@index([tenantId, delegateId])
  @@index([tenantId, startDate, endDate])
  @@index([tenantId, isActive])
  @@map("delegations")
}


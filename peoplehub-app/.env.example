# ===========================================
# PeopleHub Environment Configuration
# ===========================================
# Copy this file to .env.local and fill in the values

# -------------------------------------------
# DATABASE (PostgreSQL)
# -------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# Optional: Read replica for read-heavy queries
# DATABASE_READ_URL="postgresql://USER:PASSWORD@READ_HOST:PORT/DATABASE?schema=public"

# -------------------------------------------
# APPLICATION
# -------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=PeopleHub
PORT=3000

# -------------------------------------------
# AUTHENTICATION
# -------------------------------------------
# Generate with: openssl rand -base64 32
JWT_SECRET=
JWT_EXPIRES_IN=1d
SESSION_SECRET=

# -------------------------------------------
# SEEDING (local/dev only)
# -------------------------------------------
# Used by prisma seed scripts. Do NOT commit real values.
SEED_DEFAULT_PASSWORD=
SEED_SUPERADMIN_PASSWORD=
SEED_E2E_PASSWORD=
SUPERADMIN_PASSWORD=
# SUPERADMIN_EMAIL=superadmin@peoplehub.com

# -------------------------------------------
# ENCRYPTION (Required for sensitive data)
# -------------------------------------------
# Generate with: openssl rand -base64 32
# MUST be at least 32 characters
ENCRYPTION_KEY=

# -------------------------------------------
# FILE STORAGE
# -------------------------------------------
# Local storage (development)
UPLOAD_DIR=./public/uploads

# S3-compatible storage (production)
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=peoplehub-files
# S3_REGION=ap-southeast-1
# S3_ENDPOINT=https://s3.ap-southeast-1.amazonaws.com

# -------------------------------------------
# REDIS (Cache & Session) - Optional
# -------------------------------------------
# REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=

# -------------------------------------------
# EMAIL (SMTP) - Required for notifications
# -------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM="PeopleHub <noreply@kreatifindo.com>"

# -------------------------------------------
# MONITORING & OBSERVABILITY
# -------------------------------------------
# Sentry (Error tracking)
# SENTRY_DSN=

# Log level: debug, info, warn, error
LOG_LEVEL=info

# -------------------------------------------
# RATE LIMITING
# -------------------------------------------
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX_REQUESTS=100

# -------------------------------------------
# BACKUP CONFIGURATION (Production)
# -------------------------------------------
# BACKUP_DIR=/var/backups/peoplehub
# BACKUP_RETENTION_DAYS=30
# ENCRYPT_BACKUP=false
# UPLOAD_TO_S3=false

# -------------------------------------------
# EXTERNAL INTEGRATIONS (Optional)
# -------------------------------------------
# Google OAuth
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Slack/Discord notifications
# SLACK_WEBHOOK_URL=
# DISCORD_WEBHOOK_URL=
